---
import type { SearchMetadata } from "./types";

interface Props {
  metadata: SearchMetadata[];
  placeholder?: string;
  ariaLabel?: string;
}

const {
  metadata,
  placeholder = "Search notes...",
  ariaLabel = "Search articles",
} = Astro.props as Props;
---

<astro-search class="search-container" data-metadata={JSON.stringify(metadata)}>
  <input
    type="text"
    class="search-input"
    placeholder={placeholder}
    aria-label={ariaLabel}
  />
  <p class="search-label" hidden aria-live="polite"></p>
  <ul class="search-results"></ul>
</astro-search>

<script>
  import { registerSearchElement } from "./controller";

  registerSearchElement();
</script>
