---
const lightLabel = "Switch to dark mode";
const darkLabel = "Switch to light mode";
---

<button type="button" class="theme-toggle sidebar__action" aria-label={darkLabel}>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="theme-toggle__icon theme-toggle__icon--sun"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="5"></circle>
    <line x1="12" y1="1" x2="12" y2="3"></line>
    <line x1="12" y1="21" x2="12" y2="23"></line>
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
    <line x1="1" y1="12" x2="3" y2="12"></line>
    <line x1="21" y1="12" x2="23" y2="12"></line>
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
  </svg>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="theme-toggle__icon theme-toggle__icon--moon"
    aria-hidden="true"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<script is:inline define:vars={{ lightLabel, darkLabel }}>
  (function () {
    var button = document.querySelector(".theme-toggle");
    if (!button) return;
    var theme = document.documentElement.getAttribute("data-theme");
    button.setAttribute(
      "aria-label",
      theme === "dark" ? darkLabel : lightLabel,
    );
  })();
</script>

<script>
  const THEME_KEY = "theme";
  let listenersBound = false;

  type Theme = "light" | "dark";

  function parseTheme(value: string | null): Theme | null {
    return value === "light" || value === "dark" ? value : null;
  }

  function currentTheme(): Theme {
    return (
      parseTheme(document.documentElement.getAttribute("data-theme")) ?? "dark"
    );
  }

  function themeToggleLabel(theme: Theme): string {
    return theme === "dark" ? "Switch to light mode" : "Switch to dark mode";
  }

  function readStoredTheme(): Theme | null {
    try {
      return parseTheme(localStorage.getItem(THEME_KEY));
    } catch {
      return null;
    }
  }

  function persistTheme(theme: Theme): void {
    try {
      localStorage.setItem(THEME_KEY, theme);
    } catch {
      // localStorage unavailable (private browsing, etc.)
    }
  }

  function applyTheme(theme: Theme, button?: HTMLButtonElement | null): void {
    document.documentElement.setAttribute("data-theme", theme);
    persistTheme(theme);

    const toggle =
      button ?? document.querySelector<HTMLButtonElement>(".theme-toggle");
    toggle?.setAttribute("aria-label", themeToggleLabel(theme));
  }

  function syncToggle(): void {
    const button = document.querySelector<HTMLButtonElement>(".theme-toggle");
    const theme = readStoredTheme() ?? currentTheme();
    document.documentElement.setAttribute("data-theme", theme);
    button?.setAttribute("aria-label", themeToggleLabel(theme));
  }

  function initThemeToggle(): void {
    if (!listenersBound) {
      listenersBound = true;

      document.addEventListener("click", (event) => {
        const button = (event.target as Element).closest(".theme-toggle");
        if (!(button instanceof HTMLButtonElement)) return;

        applyTheme(currentTheme() === "dark" ? "light" : "dark", button);
      });

      document.addEventListener("astro:before-swap", (event) => {
        const theme = readStoredTheme() ?? currentTheme();
        event.newDocument.documentElement.setAttribute("data-theme", theme);
      });

      document.addEventListener("astro:after-swap", syncToggle);
    }

    syncToggle();
  }

  initThemeToggle();
</script>
