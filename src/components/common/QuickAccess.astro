---
import { ARTICLE_CATEGORIES, formatCategoryLabel } from "@/utils";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

const ariaCurrent = (slug?: string) => {
  if (!slug) return pathname === "/" ? "page" : undefined;
  return pathname === `/categories/${slug}` ||
    pathname.startsWith(`/articles/${slug}/`)
    ? "page"
    : undefined;
};

const categoryIcons: Record<string, string> = {
  "user-research":
    '<rect x="2" y="2" width="116" height="116" class="icon-fill-primary" stroke-width="4"/><rect x="27.5" y="27.5" width="60" height="60" class="icon-fill-accent" stroke-width="4"/>',
  "user-experience":
    '<circle cx="60" cy="60" r="58" class="icon-fill-primary" stroke-width="4"/><circle cx="60.2712" cy="60.2717" r="35.8371" class="icon-fill-accent" stroke-width="4"/>',
  "user-interface":
    '<circle cx="60" cy="60" r="58" class="icon-fill-accent" stroke-width="4"/>',
  "interaction-design":
    '<path d="M83.5395 29.3113L67.2736 100.729L17.5542 49.96L83.5395 29.3113Z" class="icon-fill-primary" stroke-width="4" stroke-linejoin="round"/><ellipse cx="94.2209" cy="27.562" rx="25.779" ry="27.56" class="icon-fill-accent" stroke-width="4"/>',
  "usability-testing":
    '<rect x="2" y="2" width="48" height="116" rx="8" class="icon-fill-accent" stroke-width="4"/><rect x="70" y="2" width="48" height="116" rx="8" class="icon-fill-primary" stroke-width="4"/>',
};
---

<nav class="sidebar" aria-label="Site navigation">
  <ul class="sidebar__list">
    <li class="sidebar__item">
      <a href="/" aria-label="Home" aria-current={ariaCurrent()}>
        <svg
          class="icon"
          xmlns="http://www.w3.org/2000/svg"
          width="36"
          height="36"
          viewBox="0 0 512 512"
          fill="none"
        >
          <rect
            x="460"
            y="52"
            width="407"
            height="407"
            class="icon-fill-primary"
            transform="rotate(90 460 52)"
            stroke-width="12"></rect>
          <rect
            x="256.536"
            y="91.5006"
            width="231.738"
            height="231.97"
            class="icon-fill-accent"
            transform="rotate(45.0028 256.536 91.5006)"
            stroke-width="12"></rect>
          <rect
            x="324.714"
            y="179.256"
            width="144.64"
            height="144.64"
            rx="72.3199"
            class="icon-fill-accent"
            transform="rotate(87.1271 324.714 179.256)"
            stroke-width="12"></rect>
        </svg>
      </a>
    </li>
    {
      ARTICLE_CATEGORIES.map(({ slug }) => (
        <li class="sidebar__item">
          <a
            href={`/categories/${slug}/`}
            class="sidebar__item-link"
            aria-label={formatCategoryLabel(slug)}
            aria-current={ariaCurrent(slug)}
          >
            <svg
              class="icon"
              xmlns="http://www.w3.org/2000/svg"
              width="28"
              height="28"
              viewBox="0 0 120 120"
              fill="none"
              aria-hidden="true"
              set:html={categoryIcons[slug]}
            />
            <span class="sidebar__item-title">
              {formatCategoryLabel(slug)
                .split(" ")
                .map((line) => (
                  <span>{line}</span>
                ))}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>
