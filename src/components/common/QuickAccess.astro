---
import { ARTICLE_CATEGORIES, formatCategoryLabel } from "@/utils";
import ThemeSwitcher from "@components/common/theme/ThemeSwitcher.astro";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

const ariaCurrent = (slug?: string) => {
  if (!slug) return pathname === "/" ? "page" : undefined;
  return pathname === `/categories/${slug}` ||
    pathname.startsWith(`/articles/${slug}/`)
    ? "page"
    : undefined;
};

// Drawn on a 28-unit grid so the viewBox maps 1:1 to the rendered 28px box:
// stroke centres sit on integers and shapes are inset by 1 so no outline clips.
const categoryIcons: Record<string, string> = {
  "user-research":
    '<rect x="1" y="1" width="26" height="26" class="icon-fill-primary" stroke-width="2"/><rect x="8" y="8" width="12" height="12" class="icon-fill-accent" stroke-width="2"/>',
  "user-experience":
    '<circle cx="14" cy="14" r="13" class="icon-fill-primary" stroke-width="2"/><circle cx="14" cy="14" r="8" class="icon-fill-accent" stroke-width="2"/>',
  "user-interface":
    '<circle cx="14" cy="14" r="13" class="icon-fill-accent" stroke-width="2"/>',
  "interaction-design":
    '<path d="M19 7L16 23L4 12L19 7Z" class="icon-fill-primary" stroke-width="2" stroke-linejoin="round"/><circle cx="21" cy="7" r="6" class="icon-fill-accent" stroke-width="2"/>',
  "usability-testing":
    '<rect x="1" y="1" width="11" height="26" rx="2" class="icon-fill-accent" stroke-width="2"/><rect x="16" y="1" width="11" height="26" rx="2" class="icon-fill-primary" stroke-width="2"/>',
};
---

<nav class="sidebar" aria-label="Site navigation">
  <div class="sidebar__toolbar">
    <a href="/" class="sidebar__logo" aria-label="Home" aria-current={ariaCurrent()}>
      <svg
        class="icon"
        xmlns="http://www.w3.org/2000/svg"
        width="40"
        height="40"
        viewBox="0 0 512 512"
        fill="none"
      >
        <rect
          x="460"
          y="52"
          width="407"
          height="407"
          class="icon-fill-primary"
          transform="rotate(90 460 52)"
          stroke-width="20"></rect>
        <rect
          x="256.536"
          y="91.5006"
          width="231.738"
          height="231.97"
          class="icon-fill-accent"
          transform="rotate(45.0028 256.536 91.5006)"
          stroke-width="20"></rect>
        <rect
          x="324.714"
          y="179.256"
          width="144.64"
          height="144.64"
          rx="72.3199"
          class="icon-fill-accent"
          transform="rotate(87.1271 324.714 179.256)"
          stroke-width="20"></rect>
      </svg>
    </a>
    <div class="sidebar__toolbar-actions">
      <a
        href="/search/"
        class="sidebar__item-link sidebar__action sidebar__item--search"
        aria-label="Search"
        aria-current={pathname === "/search" ? "page" : undefined}
      >
        <svg
          class="icon icon-stroke-hover"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </a>
      <div class="sidebar__theme sidebar__theme--mobile">
        <ThemeSwitcher />
      </div>
    </div>
  </div>

  <ul class="sidebar__list sidebar__categories">
    {
      ARTICLE_CATEGORIES.map(({ slug }) => (
        <li class="sidebar__item">
          <a
            href={`/categories/${slug}/`}
            class="sidebar__item-link"
            aria-label={formatCategoryLabel(slug)}
            aria-current={ariaCurrent(slug)}
          >
            <svg
              class="icon"
              xmlns="http://www.w3.org/2000/svg"
              width="28"
              height="28"
              viewBox="0 0 28 28"
              fill="none"
              aria-hidden="true"
              set:html={categoryIcons[slug]}
            />
            <span class="sidebar__item-title">
              {formatCategoryLabel(slug)
                .split(" ")
                .map((line) => (
                  <span>{line}</span>
                ))}
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  <div class="sidebar__theme sidebar__theme--desktop">
    <ThemeSwitcher />
  </div>
</nav>
