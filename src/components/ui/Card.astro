---
import { CATEGORY_ICONS, formatCategoryLabel } from "@/utils";

interface Props {
  title: string;
  readTime: string;
  category?: string;
  index: number;
  href: string;
  thumbnail?: string;
}

const { title, readTime, category, index, href, thumbnail } = Astro.props;

const displayIndex = String(index).padStart(2, "0");
const categoryLabel = category ? formatCategoryLabel(category) : undefined;
const iconSrc = category
  ? (CATEGORY_ICONS[category] ?? "/icons/categories/fundamental-icon.svg")
  : undefined;
---

<a href={href} class="card" id={`card-${displayIndex}`}>
  {
    thumbnail && (
      <div class="card__thumbnail">
        <img src={thumbnail} alt="" width="400" height="225" loading="lazy" />
      </div>
    )
  }
  <div class="card__header">
    {
      category && (
        <span class="card__tag">
          <span class="card__tag-icon">
            <img src={iconSrc} alt="" width="16" height="16" />
          </span>
          {categoryLabel}
        </span>
      )
    }
    <span class="card__index">{displayIndex}</span>
  </div>

  <div class="card__body">
    <h2 class="card__title">{title}</h2>
    <span class="card__badge">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="17"
        height="17"
        fill="none"
        viewBox="0 0 17 17"
        aria-hidden="true"
        ><circle
          cx="8.5"
          cy="8.5"
          r="6.25"
          stroke="currentColor"
          stroke-width="1.5"></circle><path
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="1.5"
          d="M8.5 5.25V8.5l2.125 1.062"></path></svg
      >{readTime} read
    </span>
  </div>
</a>
