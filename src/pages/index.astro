---
import { getCollection } from "astro:content";

import {
  deriveCategory,
  fadeUp,
  groupIntoStaggeredRows,
  staggeredCardIndex,
} from "@/utils";
import Footer from "@components/common/Footer.astro";
import Card from "@components/ui/Card.astro";
import Layout from "@layouts/Layout.astro";

const articles = (await getCollection("articles")).sort((a, b) => {
  if (a.data.featured !== b.data.featured) {
    return Number(b.data.featured) - Number(a.data.featured);
  }
  const aTime = a.data.publishedAt?.getTime() ?? 0;
  const bTime = b.data.publishedAt?.getTime() ?? 0;
  return bTime - aTime;
});

const articleRows = groupIntoStaggeredRows(articles);
---

<Layout
  description="A beginner-friendly collection of short articles that introduces UX and UI design concepts"
>
  <main transition:animate={fadeUp}>
    <header class="page-header">
      <div>
        <h1 class="page-title">Design Note</h1>
        <p class="page-subtitle">
          A beginner-friendly collection of short articles that introduces UX
          and UI design concepts.
        </p>
      </div>
    </header>

    <section
      class="grid-staggered"
      aria-label="Articles"
      style="--grid-gap: var(--spacing-2xl);"
    >
      {
        articleRows.map((row, rowIndex) => (
          <div
            class="grid-staggered__row"
            style={`--row-columns: ${row.length};`}
          >
            {row.map((article, columnIndex) => (
              <Card
                category={deriveCategory(article.id)}
                title={article.data.title}
                readTime={article.data.readTime}
                index={staggeredCardIndex(rowIndex, columnIndex)}
                thumbnail={article.data.thumbnail}
                href={`/articles/${article.id}/`}
              />
            ))}
          </div>
        ))
      }
    </section>
  </main>
</Layout>

<Footer />

<style>
  section {
    margin-bottom: var(--spacing-2xl);
  }
</style>
