---
import { getCollection } from "astro:content";

import { deriveCategory, fadeUp } from "@/utils";
import Card from "@components/ui/Card.astro";
import Grid from "@components/ui/Grid.astro";
import Layout from "@layouts/Layout.astro";

// Get all articles sorted by published date
const articles = (await getCollection("articles")).sort((a, b) => {
  const aTime = a.data.publishedAt?.getTime() ?? 0;
  const bTime = b.data.publishedAt?.getTime() ?? 0;
  return bTime - aTime;
});
---

<Layout
  description="A beginner-friendly collection of short articles that introduces UX and UI design concepts"
>
  <main id="main-content" tabindex="-1" transition:animate={fadeUp}>
    <!-- Header -->
    <header class="page-header">
      <h1 class="page-title">Design Note</h1>
      <p class="page-subtitle">
        A beginner-friendly collection of short articles that introduces UX and
        UI design concepts.
      </p>
    </header>
    <!-- Articles -->
    <Grid as="section" gap="var(--spacing-md)">
      {
        articles.map((article, index) => (
          <Card
            title={article.data.title}
            excerpt={article.data.excerpt}
            enableExcerpt={article.data.enableExcerpt}
            thumbnail={article.data.thumbnail}
            readTime={article.data.readTime}
            category={deriveCategory(article.id)}
            href={`/articles/${article.id}/`}
            loading={index < 2 ? "eager" : "lazy"}
            fetchpriority={index < 2 ? "high" : undefined}
          />
        ))
      }
    </Grid>
  </main>
</Layout>
