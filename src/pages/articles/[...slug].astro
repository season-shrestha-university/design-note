---
import { Image } from "astro:assets";
import { getCollection, getEntry, render } from "astro:content";

import {
  CATEGORY_ICONS,
  absoluteUrl,
  articleSchema,
  buildBreadcrumbJsonLd,
  deriveCategory,
  fadeUp,
  formatCategoryLabel,
  pickOtherPosts,
} from "@/utils";
import Breadcrumb from "@components/ui/Breadcrumb.astro";
import Card from "@components/ui/Card.astro";
import Figure from "@components/ui/Figure.astro";
import FurtherReadingCard from "@components/ui/FurtherReadingCard.astro";
import Grid from "@components/ui/Grid.astro";
import ArticleListen from "@components/common/listen/ArticleListen.astro";
import TextSizeControl from "@components/common/text-size/TextSizeControl.astro";
import Layout from "@layouts/Layout.astro";

export async function getStaticPaths() {
  const articles = await getCollection("articles");

  return articles.map((article) => ({
    params: { slug: article.id },
    props: {
      otherPosts: pickOtherPosts(articles, article.id),
    },
  }));
}

const { otherPosts } = Astro.props;
const slug = Astro.params.slug;
const article = slug ? await getEntry("articles", slug) : undefined;

if (!article) {
  throw new Response("Article not found", { status: 404 });
}

const articleCategory = deriveCategory(article.id);
const categoryIcon =
  CATEGORY_ICONS[articleCategory] ?? "/icons/categories/fundamental-icon.svg";
const takeaways = article.data.takeaways;
const furtherReading = article.data.furtherReading;
const { Content } = await render(article);

const categoryLabel = formatCategoryLabel(articleCategory);
const canonicalURL = new URL(`/articles/${article.id}/`, Astro.site).toString();
const breadcrumbItems = [
  { label: "Home", href: "/" },
  { label: categoryLabel, href: `/categories/${articleCategory}/` },
  { label: article.data.title, href: `/articles/${article.id}/` },
];
const shareImage = absoluteUrl(
  article.data.ogImage ?? article.data.thumbnail?.src,
  Astro.site,
);
const structuredData = [
  articleSchema({
    title: article.data.title,
    description: article.data.excerpt,
    url: canonicalURL,
    image: shareImage,
    publishedTime: article.data.publishedAt,
    modifiedTime: article.data.updatedAt,
    section: categoryLabel,
  }),
  buildBreadcrumbJsonLd(breadcrumbItems, Astro.site),
];
---

<Layout
  title={article.data.title}
  description={article.data.excerpt}
  type="article"
  image={article.data.ogImage ?? article.data.thumbnail?.src}
  section={categoryLabel}
  publishedTime={article.data.publishedAt}
  modifiedTime={article.data.updatedAt}
  jsonLd={structuredData}
>
  <div transition:animate={fadeUp}>
    <main>
      <div class="note__content container--narrow">
        <div class="note__reading-aids">
          <ArticleListen />
          <TextSizeControl />
        </div>
        <div class="note__readable">
          <Breadcrumb items={breadcrumbItems} />
          <div data-listen-content>
            <header class="note__header">
              <h1 class="note__title">{article.data.title}</h1>
              <span class="note_category card__badge"
                >{formatCategoryLabel(articleCategory)}</span
              >
              <p class="note__subtitle">{article.data.excerpt}</p>
              {
                article.data.thumbnail && (
                  <div class="note__thumbnail-media">
                    <Image
                      class="note__thumbnail"
                      src={article.data.thumbnail}
                      alt={article.data.title}
                      widths={[640, 960, 1200]}
                      sizes="(max-width: 800px) 100vw, 800px"
                      quality={85}
                      loading="eager"
                      fetchpriority="high"
                    />
                  </div>
                )
              }
              <img class="note__visual" src={categoryIcon} alt="" />
            </header>
            {
              takeaways && takeaways.length > 0 && (
                <ol class="note__takeaway">
                  {takeaways.map((takeaway, index) => (
                    <li class="note__takeaway__item">
                      <span class="note__takeaway__number">
                        {String(index + 1).padStart(2, "0")}
                      </span>
                      <p>{takeaway}</p>
                    </li>
                  ))}
                </ol>
              )
            }

            <div class="note__description">
              <Content components={{ Figure }} />
            </div>
          </div>

          {
            furtherReading && furtherReading.length > 0 && (
              <>
                <h2 class="note__further__reading__title">Further Reading</h2>
                <ul class="note__further__reading__list">
                  {furtherReading.map((item) => (
                    <FurtherReadingCard
                      title={item.title}
                      subtitle={item.subtitle}
                      href={item.link}
                    />
                  ))}
                </ul>
              </>
            )
          }
        </div>
      </div>

      {
        otherPosts.length > 0 && (
          <section
            class="note__other-posts"
            aria-labelledby="other-posts-heading"
          >
            <h2 id="other-posts-heading" class="note__further__reading__title">
              Other posts
            </h2>
            <Grid gap="var(--spacing-xl)">
              {otherPosts.map((post) => (
                <Card
                  title={post.data.title}
                  excerpt={post.data.excerpt}
                  enableExcerpt={false}
                  thumbnail={post.data.thumbnail}
                  readTime={post.data.readTime}
                  category={deriveCategory(post.id)}
                  href={`/articles/${post.id}/`}
                />
              ))}
            </Grid>
          </section>
        )
      }
    </main>
  </div>
</Layout>
