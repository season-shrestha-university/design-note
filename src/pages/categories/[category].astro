---
import { getCollection } from "astro:content";

import {
  CATEGORY_ICONS,
  buildBreadcrumbJsonLd,
  fadeUp,
  formatCategoryLabel,
} from "@/utils";
import Breadcrumb from "@components/ui/Breadcrumb.astro";
import Card from "@components/ui/Card.astro";
import Grid from "@components/ui/Grid.astro";
import Layout from "@layouts/Layout.astro";

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  const categories = [
    ...new Set(articles.map((article) => article.id.split("/")[0])),
  ];

  return categories.map((category) => ({
    params: { category },
  }));
}

const category = Astro.params.category as string;

const categoryArticles = (
  await getCollection("articles", ({ id }) => id.split("/")[0] === category)
).sort((a, b) => {
  const aTime = a.data.publishedAt?.getTime() ?? 0;
  const bTime = b.data.publishedAt?.getTime() ?? 0;
  return bTime - aTime;
});

const categoryLabel = formatCategoryLabel(category);
const description = `Design notes on ${categoryLabel.toLowerCase()} — ${categoryArticles.length} browsable references on interface patterns and why they work.`;
const breadcrumbItems = [
  { label: "Home", href: "/" },
  { label: categoryLabel, href: `/categories/${category}/` },
];

const structuredData = [buildBreadcrumbJsonLd(breadcrumbItems, Astro.site)];
---

<Layout title={categoryLabel} description={description} jsonLd={structuredData}>
  <main transition:animate={fadeUp}>
    <Breadcrumb items={breadcrumbItems} />
    <header class="category-title">
      <img src={CATEGORY_ICONS[category]} alt={formatCategoryLabel(category)} />
      <h1>
        {formatCategoryLabel(category)}
      </h1>
    </header>

    <Grid as="section" gap="var(--spacing-xl)">
      {
        categoryArticles.map((article, index) => (
          <Card
            title={article.data.title}
            excerpt={article.data.excerpt}
            enableExcerpt={article.data.enableExcerpt}
            thumbnail={article.data.thumbnail}
            readTime={article.data.readTime}
            category={category}
            href={`/articles/${article.id}/`}
            loading={index < 2 ? "eager" : "lazy"}
            fetchpriority={index < 2 ? "high" : undefined}
          />
        ))
      }
    </Grid>
  </main>
</Layout>

<style>
  .category-title {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-2xl);
    color: var(--primary-color);
  }
</style>
