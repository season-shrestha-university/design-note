---
import { getCollection } from "astro:content";

import {
  CATEGORY_ICONS,
  breadcrumbSchema,
  fadeUp,
  formatCategoryLabel,
} from "@/utils";
import Card from "@components/ui/Card.astro";
import Grid from "@components/ui/Grid.astro";
import Layout from "@layouts/Layout.astro";

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  const categories = [
    ...new Set(articles.map((article) => article.id.split("/")[0])),
  ];

  return categories.map((category) => ({
    params: { category },
  }));
}

const category = Astro.params.category as string;

const categoryArticles = (
  await getCollection("articles", ({ id }) => id.split("/")[0] === category)
).sort((a, b) => {
  const aTime = a.data.publishedAt?.getTime() ?? 0;
  const bTime = b.data.publishedAt?.getTime() ?? 0;
  return bTime - aTime;
});

const categoryLabel = formatCategoryLabel(category);
const description = `Design notes on ${categoryLabel.toLowerCase()} — ${categoryArticles.length} browsable references on interface patterns and why they work.`;

const structuredData = [
  breadcrumbSchema({
    items: [
      { name: "Home", url: new URL("/", Astro.site).toString() },
      {
        name: "Categories",
        url: new URL("/categories/", Astro.site).toString(),
      },
      {
        name: categoryLabel,
        url: new URL(`/categories/${category}/`, Astro.site).toString(),
      },
    ],
  }),
];
---

<Layout title={categoryLabel} description={description} jsonLd={structuredData}>
  <main transition:animate={fadeUp}>
    <header class="category-title">
      <img src={CATEGORY_ICONS[category]} alt={formatCategoryLabel(category)} />
      <h1>
        {formatCategoryLabel(category)}
      </h1>
    </header>
    <Grid as="section" gap="var(--spacing-xl)">
      {
        categoryArticles.map((article) => (
          <Card
            title={article.data.title}
            excerpt={article.data.excerpt}
            thumbnail={article.data.thumbnail}
            readTime={article.data.readTime}
            category={category}
            href={`/articles/${article.id}/`}
          />
        ))
      }
    </Grid>
  </main>
</Layout>

<style>
  .category-title {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-2xl);
    color: var(--primary-color);
  }
</style>
