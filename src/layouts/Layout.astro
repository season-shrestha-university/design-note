---
import Header from "@/components/common/Header.astro";
import Footer from "@components/common/Footer.astro";
import QuickAccess from "@components/common/QuickAccess.astro";
import Clarity from "@components/common/Clarity.astro";
import SEO from "@components/common/SEO.astro";
import { SITE, websiteSchema, type JsonLd, type SeoProps } from "@/utils";
import { TEXT_SIZE_SCALE_STEPS, TEXT_SIZE_STORAGE_KEY } from "@/utils/textSize";
import "@fontsource/ibm-plex-sans/latin-400.css";
import "@fontsource/ibm-plex-sans/latin-400-italic.css";
import "@fontsource/ibm-plex-sans/latin-500.css";
import "@fontsource/ibm-plex-sans/latin-600.css";
import "@fontsource/ibm-plex-sans/latin-700.css";
import "@fontsource/ibm-plex-sans-condensed/latin-700.css";
import "@fontsource/ibm-plex-mono/latin-700.css";
import "@styles/main.css";
import SpeedInsights from "@vercel/speed-insights/astro";
import { ClientRouter } from "astro:transitions";

interface Props extends SeoProps {
  class?: string;
}

const { class: className, jsonLd, ...seo } = Astro.props;

const THEME_STORAGE_KEY = "theme";

// Every page carries the WebSite schema; pages may append their own (Article, Breadcrumb).
const structuredData: JsonLd[] = [
  websiteSchema({ site: Astro.site }),
  ...(jsonLd ?? []),
];
---

<!doctype html>
<html
  lang={SITE.lang}
  data-theme="dark"
  transition:name="root"
  transition:animate="none"
>
  <head>
    <ClientRouter />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script
      is:inline
      define:vars={{
        storageKey: TEXT_SIZE_STORAGE_KEY,
        scaleSteps: TEXT_SIZE_SCALE_STEPS,
        themeKey: THEME_STORAGE_KEY,
      }}
    >
      try {
        var step = localStorage.getItem(storageKey);
        if (step !== null) {
          var index = Number(step);
          if (index >= 0 && index < scaleSteps.length) {
            document.documentElement.style.setProperty(
              "--font-scale",
              String(scaleSteps[index]),
            );
          }
        }
      } catch (_) {}

      try {
        var theme = localStorage.getItem(themeKey);
        if (theme === "light" || theme === "dark") {
          document.documentElement.setAttribute("data-theme", theme);
        }
      } catch (_) {}
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <SEO {...seo} jsonLd={structuredData} />
    <Clarity />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <QuickAccess />
    <div class:list={["container", className]}>
      <slot />
      <Footer />
      <Header hidden={!Astro.url.pathname.startsWith("/articles/")} />
      <SpeedInsights />
    </div>
  </body>
</html>
